{
  "main": ".open-next/worker.js",
  "name": "next-porto-chimera",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
